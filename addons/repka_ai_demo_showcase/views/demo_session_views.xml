<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_demo_session_list" model="ir.ui.view">
        <field name="name">repka.ai.demo.session.list</field>
        <field name="model">repka.ai.demo.session</field>
        <field name="arch" type="xml">
            <list create="1" edit="0" delete="0">
                <field name="name"/>
                <field name="user_id"/>
                <field name="state" widget="badge"/>
                <field name="create_date"/>
            </list>
        </field>
    </record>
    <record id="view_demo_session_form" model="ir.ui.view">
        <field name="name">repka.ai.demo.session.form</field>
        <field name="model">repka.ai.demo.session</field>
        <field name="arch" type="xml">
            <form string="Демонстрация сценариев" delete="0">
                <header>
                    <button name="action_prepare" type="object" string="Начать показ" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_finish" type="object" string="Завершить показ" class="btn-secondary" invisible="state != 'active'" confirm="Удалить только данные и результаты текущего показа? Другие записи базы не изменятся."/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <div class="alert alert-info" role="alert">ДЕМО: показаны синтетические записи. Сценарии считают по примерам JSON из каталога, а не по другим данным Odoo; изменение записи вручную не пересчитывает результат. Не обученный ИИ.</div>
                    <group>
                        <field name="name"/>
                        <field name="user_id"/>
                        <field name="required_document_types" invisible="state != 'active'"/>
                    </group>
                    <group string="Четыре сценария" invisible="state != 'active'">
                        <button name="action_run_customer_360" type="object" string="1. Профиль клиента" class="btn-primary"/>
                        <button name="action_run_margin_watch" type="object" string="2. Экономика перевозок" class="btn-primary"/>
                        <button name="action_run_document_readiness" type="object" string="3. Готовность документов" class="btn-primary"/>
                        <button name="action_run_executive_brief" type="object" string="4. Сводка руководителю" class="btn-primary"/>
                    </group>
                    <group string="Синтетические записи: данные до запуска" invisible="state != 'active'">
                        <button name="action_open_partners" type="object" string="Открыть клиентов"/>
                        <button name="action_open_orders" type="object" string="Открыть заказы"/>
                        <button name="action_open_documents" type="object" string="Открыть документы"/>
                    </group>
                    <notebook invisible="state != 'active'">
                        <page string="Результаты: после запуска">
                            <field name="result_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="summary"/>
                                    <field name="create_date"/>
                                </list>
                            </field>
                        </page>
                        <page string="Синтетические заказы">
                            <field name="order_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="partner_id"/>
                                    <field name="order_date"/>
                                    <field name="is_paid"/>
                                    <field name="demo_revenue"/>
                                    <field name="demo_direct_cost"/>
                                    <field name="demo_currency_code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_demo_result_form" model="ir.ui.view">
        <field name="name">repka.ai.demo.result.form</field>
        <field name="model">repka.ai.demo.result</field>
        <field name="arch" type="xml">
            <form string="Результат сценария" edit="0" create="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="alert">ДЕМО: результат настоящего сценария по примеру JSON из каталога, не по текущим данным Odoo. Рабочие заказы не меняются.</div>
                    <group>
                        <field name="name"/>
                        <field name="session_id" readonly="1"/>
                        <field name="create_date"/>
                        <field name="summary"/>
                    </group>
                    <field name="details" nolabel="1" readonly="1"/>
                </sheet>
            </form>
        </field>
    </record>
    <record id="view_demo_order_list" model="ir.ui.view">
        <field name="name">ufs.base.order.demo.list</field>
        <field name="model">ufs.base.order</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0">
                <field name="name"/>
                <field name="partner_id"/>
                <field name="order_date"/>
                <field name="is_paid"/>
                <field name="demo_revenue"/>
                <field name="demo_direct_cost"/>
                <field name="demo_currency_code"/>
            </list>
        </field>
    </record>
    <record id="view_demo_order_form" model="ir.ui.view">
        <field name="name">ufs.base.order.demo.form</field>
        <field name="model">ufs.base.order</field>
        <field name="arch" type="xml">
            <form string="Синтетический заказ" create="0" edit="0" delete="0">
                <sheet>
                    <div class="alert alert-info" role="alert">ДЕМО: данные заказа вымышлены. Выручка и прямые затраты не являются бухгалтерскими показателями.</div>
                    <group>
                        <field name="name"/>
                        <field name="partner_id"/>
                        <field name="order_date"/>
                        <field name="is_paid"/>
                        <field name="demo_revenue"/>
                        <field name="demo_direct_cost"/>
                        <field name="demo_currency_code"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
    <record id="action_demo_sessions" model="ir.actions.act_window">
        <field name="name">Демо AI-сценариев</field>
        <field name="res_model">repka.ai.demo.session</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_demo_showcase" name="Демо AI-сценариев" action="action_demo_sessions" sequence="85" groups="base.group_system"/>
</odoo>
