<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="module_category_repka" model="ir.module.category">
        <field name="name">РЕПКА</field>
        <field name="sequence">30</field>
    </record>

    <record id="group_repka_user" model="res.groups">
        <field name="name">Пользователь</field>
        <field name="category_id" ref="repka_base.module_category_repka"/>
    </record>

    <record id="group_repka_manager" model="res.groups">
        <field name="name">Руководитель</field>
        <field name="category_id" ref="repka_base.module_category_repka"/>
        <field name="implied_ids" eval="[(4, ref('repka_base.group_repka_user'))]"/>
    </record>
</odoo>
