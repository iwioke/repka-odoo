<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fleet_order_reference_form" model="ir.ui.view">
        <field name="name">ufs.fleet.order.form.repka</field>
        <field name="model">ufs.fleet.order</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Транспортные заказы">
                <header>
                    <field name="state_id" widget="statusbar" options="{'clickable': true, 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <field name="base_order_id" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(account.action_move_out_invoice_type)d" type="action" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Счета"/>
                        </button>
                        <button name="%(repka_fleet.action_view_ufs_fleet_trip)d" type="action" class="oe_stat_button" icon="fa-truck">
                            <field name="trips_count" widget="statinfo" string="Рейсы"/>
                        </button>
                        <button name="%(account.action_account_payments)d" type="action" class="oe_stat_button" icon="fa-money" string="Банковская оплата"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Транспортные заказы"/>
                        <h1><field name="name" placeholder="Новый"/></h1>
                    </div>
                    <div class="d-flex gap-2 mb-3">
                        <button name="action_set_customer_order" type="object" string="Для клиента" class="btn-secondary"/>
                        <button name="action_set_internal_order" type="object" string="Внутренний заказ" class="btn-secondary"/>
                        <button name="action_request_advance_invoice" type="object" string="Запросить авансовый счёт" class="btn-secondary" invisible="advance_invoice_requested"/>
                    </div>
                    <group>
                        <group>
                            <field name="sequence_name" string="Номер заказа"/>
                            <field name="next_by_start_date" string="Нумерация по дате начала"/>
                            <field name="company_id" string="Компания"/>
                            <field name="responsible_user_id" string="Ответственный"/>
                            <field name="order_date" string="Дата заказа"/>
                            <field name="partner_id" string="Партнёр"/>
                            <field name="contact_person_id" string="Контактное лицо"/>
                            <field name="incoming_ref" string="Входящая заявка"/>
                            <field name="external_nr" string="Номер 1С"/>
                            <field name="ufs_contract_id" string="Договор"/>
                            <field name="ufs_payment_term_id" string="Условия оплаты"/>
                            <field name="n_days_count" string="N"/>
                            <field name="print_stamp" string="Факсимиле печати"/>
                        </group>
                        <group>
                            <field name="truck_id" string="Тягач"/>
                            <field name="trailer_id" string="П.прицеп"/>
                            <field name="trailer_type" string="Тип (п-)прицепа" readonly="1"/>
                            <field name="vehicle_responsible_id" string="Диспетчер"/>
                            <field name="driver_id" string="Водитель"/>
                            <field name="driver2_id" string="Водитель 2"/>
                            <field name="invoice_status" string="Статус счёта"/>
                            <field name="invoice_ids" string="Счета" widget="many2many_tags" readonly="1"/>
                            <field name="freight_amount" string="Фрахт"/>
                            <field name="freight_currency_id" string="Валюта"/>
                            <field name="invoice_notes" string="Примечания для счёта"/>
                            <field name="trip_ids" string="Рейсы" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Маршрут и даты" name="transport_route">
                            <group>
                                <group>
                                    <field name="origin_city" string="Город отправления"/>
                                    <field name="destination_city" string="Город назначения"/>
                                    <field name="start_datetime" string="Начало"/>
                                    <field name="stop_datetime" string="Окончание"/>
                                </group>
                                <group>
                                    <field name="planned_loading_date"/>
                                    <field name="actual_loading_date"/>
                                    <field name="planned_unloading_date"/>
                                    <field name="actual_unloading_date"/>
                                </group>
                            </group>
                            <separator string="Точки маршрута"/>
                            <field name="route_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="line_type" string="Тип"/>
                                    <field name="datetime" string="Дата и время"/>
                                    <field name="fact_arrival_dttm" string="Факт прибытия" optional="show"/>
                                    <field name="partner_id" string="Место"/>
                                    <field name="location_id" string="Адрес"/>
                                    <field name="location_postcode" string="Индекс" readonly="1"/>
                                    <field name="notes" string="Заметки"/>
                                </list>
                            </field>
                        </page>
                        <page string="Грузы" name="transport_cargo">
                            <group>
                                <field name="cargo_type"/>
                                <field name="cargo_weight" readonly="1"/>
                                <field name="cargo_volume" readonly="1"/>
                                <field name="pallets"/>
                            </group>
                            <field name="cargo_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="cargo_id" string="Груз"/>
                                    <field name="name" string="Название"/>
                                    <field name="weight" string="Вес"/>
                                    <field name="cargo_volume" string="Объём"/>
                                    <field name="pallet_count" string="Паллеты"/>
                                    <field name="units_count" string="Мест"/>
                                </list>
                            </field>
                        </page>
                        <page string="Рейсы" name="transport_trips">
                            <field name="trip_ids" nolabel="1" readonly="1"/>
                        </page>
                        <page string="Финансы и расходы" name="transport_finance">
                            <group>
                                <group>
                                    <field name="freight_amount" string="Фрахт"/>
                                    <field name="carrier_id"/>
                                    <field name="carrier_rate"/>
                                    <field name="margin" readonly="1"/>
                                </group>
                                <group>
                                    <field name="full_costs_sum" readonly="1"/>
                                    <field name="full_costs_base_sum" readonly="1"/>
                                    <field name="order_internal_margin" readonly="1"/>
                                </group>
                            </group>
                            <field name="fleet_cost_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="product_id" string="Расход"/>
                                    <field name="partner_id" string="Поставщик"/>
                                    <field name="product_qty" string="Количество"/>
                                    <field name="price_unit" string="Цена"/>
                                    <field name="amount" string="Сумма" readonly="1"/>
                                </list>
                            </field>
                        </page>
                        <page string="Документы и счета" name="transport_documents">
                            <field name="ufs_attached_document_ids" widget="many2many_tags"/>
                            <field name="invoice_ids" widget="many2many_tags" readonly="1"/>
                            <field name="invoice_notes"/>
                        </page>
                        <page string="Примечания" name="transport_notes">
                            <field name="order_memo" nolabel="1" placeholder="Добавьте примечания"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter open_attachments="True" reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="forwarder_order_reference_form" model="ir.ui.view">
        <field name="name">ufs.forwarder.order.form.repka</field>
        <field name="model">ufs.forwarder.order</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Экспедиционные заказы">
                <header>
                    <field name="state_id" widget="statusbar" options="{'clickable': true, 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <field name="base_order_id" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <div class="oe_button_box" name="button_box">
                        <button name="%(account.action_move_out_invoice_type)d" type="action" class="oe_stat_button" icon="fa-pencil-square-o">
                            <field name="invoice_count" widget="statinfo" string="Счета клиенту"/>
                        </button>
                        <button name="%(account.action_account_payments)d" type="action" class="oe_stat_button" icon="fa-money" string="Банковская оплата"/>
                    </div>
                    <div class="oe_title">
                        <label for="name" string="Экспедиционные заказы"/>
                        <h1><field name="name" placeholder="Новый"/></h1>
                    </div>
                    <div class="d-flex gap-2 mb-3">
                        <button name="action_request_advance_invoice" type="object" string="Запросить авансовый счёт" class="btn-secondary" invisible="advance_invoice_requested"/>
                        <button name="%(repka_forwarding.action_create_suborder)d" type="action" string="Новый подзаказ" class="btn-secondary"/>
                        <button name="action_auto_suborder" type="object" string="Авто Подзаказ" class="btn-secondary"/>
                        <button name="%(account.action_move_out_invoice_type)d" type="action" string="Выставить счёт" class="btn-secondary"/>
                    </div>
                    <group>
                        <group>
                            <field name="name" string="Номер заказа"/>
                            <field name="partner_id" string="Заказчик"/>
                            <field name="parent_partner_id" string="Головной партнёр" readonly="1"/>
                            <field name="incoming_ref" string="Входящая заявка"/>
                            <field name="external_nr" string="Внешний номер"/>
                            <field name="order_date" string="Дата заказа"/>
                            <field name="ufs_contract_id" string="Договор"/>
                            <field name="ufs_payment_term_id" string="Условия оплаты"/>
                            <field name="n_days_count" string="N"/>
                            <field name="order_finish_date" string="Дата выгрузки (акта)"/>
                            <field name="print_stamp" string="Факсимиле печати"/>
                        </group>
                        <group>
                            <field name="company_id" string="Компания"/>
                            <field name="order_type" string="Тип заказа"/>
                            <field name="responsible_user_id" string="Ответственный"/>
                            <label for="freight_amount" string="Фрахт"/>
                            <div class="o_row">
                                <field name="freight_amount" nolabel="1"/>
                                <field name="freight_currency_id" nolabel="1"/>
                            </div>
                            <label for="services_included_line_ids" string="Включённые услуги"/>
                            <field name="services_included_line_ids" nolabel="1" context="{'default_currency_id': freight_currency_id, 'default_qty': 1.0}">
                                <list editable="bottom">
                                    <field name="product_id" string="Услуга" required="1" context="{'default_type': 'service'}" domain="[('type', '=', 'service')]"/>
                                    <field name="qty" string="Кол-во"/>
                                    <field name="price" string="Цена"/>
                                    <field name="currency_id" string="Валюта" required="1"/>
                                    <field name="amount" string="Всего" readonly="1" sum="Всего"/>
                                </list>
                            </field>
                            <label for="amount" string="Сумма (баз. валюта)"/>
                            <field name="amount" nolabel="1" readonly="1"/>
                            <label for="amount_company_currency" string="Сумма (вал. компании)"/>
                            <field name="amount_company_currency" nolabel="1" readonly="1"/>
                            <label for="profitability_by_sub" string="Маржа по подзаказам"/>
                            <field name="profitability_by_sub" nolabel="1" readonly="1"/>
                            <label for="sl_freight_amount" string="Фрахт (услуги)"/>
                            <field name="sl_freight_amount" nolabel="1" readonly="1"/>
                            <label for="sl_mark_amount" string="Маркировка (услуги)"/>
                            <field name="sl_mark_amount" nolabel="1" readonly="1"/>
                            <label for="sl_ved_amount" string="ВЭД (услуги)"/>
                            <field name="sl_ved_amount" nolabel="1" readonly="1"/>
                            <label for="sl_freight_margin" string="Маржа по фрахту (услуги)"/>
                            <field name="sl_freight_margin" nolabel="1" readonly="1"/>
                            <label for="sl_mark_margin" string="Маржа по маркировке (услуги)"/>
                            <field name="sl_mark_margin" nolabel="1" readonly="1"/>
                            <label for="sl_ved_margin" string="Маржа по ВЭД (услуги)"/>
                            <field name="sl_ved_margin" nolabel="1" readonly="1"/>
                            <label for="sl_freight_responsible_id" string="Ответственный за фрахт"/>
                            <field name="sl_freight_responsible_id" nolabel="1"/>
                            <label for="sl_mark_responsible_id" string="Ответственный за маркировку"/>
                            <field name="sl_mark_responsible_id" nolabel="1"/>
                            <label for="sl_ved_responsible_id" string="Ответственный за ВЭД"/>
                            <field name="sl_ved_responsible_id" nolabel="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Строки заказа" name="forwarder_lines">
                            <field name="route_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="line_type" string="Тип"/>
                                    <field name="datetime" string="Дата и время"/>
                                    <field name="partner_id" string="Партнёр"/>
                                    <field name="location_id" string="Адрес"/>
                                    <field name="fact_arrival_dttm" string="Факт прибытия"/>
                                    <field name="notes" string="Примечания"/>
                                </list>
                            </field>
                        </page>
                        <page string="Маршрут и даты" name="forwarder_route">
                            <group>
                                <group>
                                    <field name="origin_city" string="Город отправления"/>
                                    <field name="origin_id" string="Место отправления"/>
                                    <field name="destination_city" string="Город назначения"/>
                                    <field name="destination_id" string="Место назначения"/>
                                </group>
                                <group>
                                    <field name="planned_loading_date"/>
                                    <field name="actual_loading_date"/>
                                    <field name="planned_unloading_date"/>
                                    <field name="actual_unloading_date"/>
                                </group>
                            </group>
                        </page>
                        <page string="Подзаказы" name="forwarder_suborders">
                            <field name="sub_order_ids" nolabel="1">
                                <list>
                                    <field name="name" string="Номер"/>
                                    <field name="state_id" string="Статус"/>
                                    <field name="partner_id" string="Партнёр"/>
                                    <field name="carrier_id" string="Перевозчик"/>
                                    <field name="freight_amount" string="Фрахт"/>
                                    <field name="carrier_rate" string="Ставка"/>
                                    <field name="margin" string="Маржа"/>
                                    <field name="verbose_route" string="Маршрут"/>
                                </list>
                            </field>
                        </page>
                        <page string="Грузы" name="forwarder_cargo">
                            <group>
                                <field name="cargo_type"/>
                                <field name="cargo_weight" readonly="1"/>
                                <field name="cargo_volume" readonly="1"/>
                            </group>
                            <field name="cargo_line_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="cargo_id" string="Груз"/>
                                    <field name="name" string="Название"/>
                                    <field name="weight" string="Вес"/>
                                    <field name="cargo_volume" string="Объём"/>
                                    <field name="units_count" string="Мест"/>
                                </list>
                            </field>
                        </page>
                        <page string="Транспорт" name="forwarder_transport">
                            <field name="ufs_truck_ids" widget="many2many_tags" string="Тягачи"/>
                            <field name="ufs_trailer_ids" widget="many2many_tags" string="Прицепы"/>
                            <field name="ufs_driver_ids" widget="many2many_tags" string="Водители"/>
                            <field name="fleet_trip_ids" widget="many2many_tags" string="Рейсы"/>
                        </page>
                        <page string="Счета и документы" name="forwarder_documents">
                            <field name="invoice_ids" widget="many2many_tags" readonly="1"/>
                            <field name="ufs_attached_document_ids" widget="many2many_tags" readonly="1"/>
                            <field name="invoice_notes"/>
                        </page>
                        <page string="Примечания" name="forwarder_notes">
                            <field name="order_memo" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter open_attachments="True" reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="forwarder_suborder_reference_form" model="ir.ui.view">
        <field name="name">ufs.forwarder.suborder.form.repka</field>
        <field name="model">ufs.forwarder.suborder</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Подзаказы экспедиции">
                <header>
                    <field name="state_id" widget="statusbar" options="{'clickable': true, 'fold_field': 'fold'}"/>
                </header>
                <sheet>
                    <field name="base_order_id" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <div class="oe_title"><h1><field name="name" placeholder="Новый подзаказ"/></h1></div>
                    <group>
                        <group>
                            <field name="forwarder_order_id" string="Экспедиционный заказ"/>
                            <field name="sub_order_type_id" string="Тип подзаказа"/>
                            <field name="partner_id" string="Партнёр"/>
                            <field name="carrier_id" string="Перевозчик"/>
                            <field name="responsible_user_id" string="Ответственный"/>
                            <field name="order_date" string="Дата заказа"/>
                        </group>
                        <group>
                            <field name="freight_amount" string="Фрахт"/>
                            <field name="carrier_rate" string="Ставка перевозчика"/>
                            <field name="margin" string="Маржа" readonly="1"/>
                            <field name="currency_id" string="Валюта"/>
                            <field name="start_datetime" string="Начало"/>
                            <field name="stop_datetime" string="Окончание"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Маршрут" name="suborder_route">
                            <field name="route_ids" nolabel="1">
                                <list editable="bottom">
                                    <field name="line_type" string="Тип"/>
                                    <field name="datetime" string="Дата и время"/>
                                    <field name="location_id" string="Адрес"/>
                                    <field name="partner_id" string="Партнёр"/>
                                    <field name="notes" string="Примечания"/>
                                </list>
                            </field>
                        </page>
                        <page string="Услуги" name="suborder_services">
                            <field name="services_included_line_ids" nolabel="1"/>
                        </page>
                        <page string="Грузы" name="suborder_cargo">
                            <field name="cargo_line_ids" nolabel="1"/>
                        </page>
                        <page string="Транспорт" name="suborder_transport">
                            <group>
                                <field name="ufs_truck_id" string="Тягач"/>
                                <field name="ufs_trailer_id" string="Прицеп"/>
                                <field name="ufs_driver_id" string="Водитель"/>
                                <field name="ufs_driver2_id" string="Водитель 2"/>
                            </group>
                        </page>
                        <page string="Примечания" name="suborder_notes">
                            <field name="order_memo" nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter open_attachments="True" reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="waybill_reference_form" model="ir.ui.view">
        <field name="name">ufs.waybill.form.repka</field>
        <field name="model">ufs.waybill</field>
        <field name="priority">1</field>
        <field name="arch" type="xml">
            <form string="Путевые листы">
                <header>
                    <button name="action_mark_in_progress" type="object" string="В пути" class="btn-secondary" invisible="state != 'issued'"/>
                    <button name="action_mark_returned" type="object" string="Возвращён" class="btn-primary" invisible="state not in ('issued', 'in_progress')"/>
                    <button name="action_mark_closed" type="object" string="Закрыть" class="btn-secondary" invisible="state != 'returned'"/>
                    <button name="action_duplicate_without_number" type="object" string="Дублировать без номера" class="btn-secondary"/>
                    <field name="state" widget="statusbar" statusbar_visible="issued,in_progress,returned,closed"/>
                </header>
                <sheet>
                    <div class="oe_title"><h1><field name="name" placeholder="Новый"/></h1></div>
                    <group>
                        <group>
                            <field name="truck_id" string="Тягач"/>
                            <field name="trailer_id" string="Прицеп"/>
                            <field name="departure_dttm" string="Дата и время выезда"/>
                            <field name="medic_control_dep_dttm" string="Дата и время врача — выезд"/>
                            <field name="odometer_dep" string="Одометр — выезд"/>
                        </group>
                        <group>
                            <field name="driver_id" string="Водитель"/>
                            <field name="driver2_id" string="Водитель 2"/>
                            <field name="return_dttm" string="Время возвращения"/>
                            <field name="arrival_dttm" string="Дата и время прибытия"/>
                            <field name="medic_control_ret_dttm" string="Дата и время врача — прибытие"/>
                            <field name="odometer_ret" string="Одометр — прибытие"/>
                        </group>
                    </group>
                    <group>
                        <group>
                            <field name="issue_date" string="Дата выдачи"/>
                            <field name="mileage" string="Пробег" readonly="1"/>
                        </group>
                        <group>
                            <field name="fuel_issued"/>
                            <field name="fuel_remaining"/>
                        </group>
                    </group>
                    <field name="notes" string="Примечания"/>
                    <field name="reverse_trip_ids" nolabel="1" readonly="1">
                        <list create="0" delete="0" edit="0">
                            <field name="name" string="Рейс №"/>
                            <field name="start_datetime" string="Начало"/>
                            <field name="stop_datetime" string="Окончание"/>
                            <field name="vehicle_id" string="Тягач"/>
                            <field name="trailer_id" string="Прицеп"/>
                            <field name="driver_id" string="Водитель"/>
                            <field name="trip_route" string="Маршрут"/>
                            <field name="state" string="Статус"/>
                        </list>
                    </field>
                </sheet>
                <chatter open_attachments="True" reload_on_attachment="True"/>
            </form>
        </field>
    </record>

    <record id="fleet_vehicle_reference_form" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.repka.blocks</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <field name="repka_operational_state" widget="statusbar" statusbar_visible="ready,repair,decommissioned"/>
                </header>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Характеристики" name="repka_characteristics">
                    <group>
                        <group>
                            <field name="manufacture_year" string="Год производства"/>
                            <field name="color" string="Цвет"/>
                            <field name="unit_weight" string="Собственный вес, кг"/>
                            <field name="engine_nr" string="Номер двигателя"/>
                            <field name="registration_doc_nr" string="Номер техпаспорта"/>
                        </group>
                        <group>
