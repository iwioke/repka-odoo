<?xml version="1.0" encoding="utf-8"?>
<odoo>
<data>
    <record id="view_ufs_ufs_waybill_filter" model="ir.ui.view">
        <field name="name">ufs.waybill.filter</field>
        <field name="model">ufs.waybill</field>
        <field name="type">search</field>
        <field name="priority">16</field>
        <field name="arch"><![CDATA[<search string="Search">
        <field name="issue_date"/>
        <field name="truck_id"/>
        <field name="trailer_id"/>
        <field name="driver_id"/>
        <field name="driver2_id"/>
        <field name="name"/>
        <field name="departure_dttm"/>
        <field name="return_dttm"/>
        <field name="notes"/>
        <separator/>
        <filter name="filter_my_waybills" string="My Waybills" domain="[('create_uid', '=', uid)]"/>
        <filter name="filter_this_month" string="This Month" date="issue_date"/>
        <group string="Group by...">
          <filter string="Truck" name="group_truck_id" context="{'group_by': 'truck_id'}"/>
          <filter string="Driver" name="group_driver_id" context="{'group_by': 'driver_id'}"/>
          <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
          <filter string="Issue Date" name="group_issue_date" context="{'group_by': 'issue_date'}"/>
        </group>
      </search>]]></field>
    </record>
    <record id="ufs_ufs_waybill_form" model="ir.ui.view">
        <field name="name">ufs.waybill.form</field>
        <field name="model">ufs.waybill</field>
        <field name="type">form</field>
        <field name="priority">16</field>
        <field name="arch"><![CDATA[<form string="Request">
        <header>
          <field name="state" widget="statusbar" options="{'clickable': false, 'fold_field': 'fold'}"/>
          
          
          
          
          
        </header>
        <sheet>
          <h2>
            <field name="name" readonly="1"/>
          </h2>
          <group>
            <group id="left">
              <field name="truck_id" options="{'no_create': True, 'no_create_edit': True}"/>
              <field name="trailer_id" options="{'no_create': True, 'no_create_edit': True}"/>
              <!--              <field name="ufs_trailer_id" options="{'no_quick_create': True}" />-->
              <field name="departure_dttm"/>
              <field name="medic_control_dep_dttm"/>
              <field name="odometer_dep"/>
            </group>
            <group id="right">
              <field name="driver_id" options="{'no_create': True, 'no_create_edit': True}"/>
              <field name="driver2_id" options="{'no_create': True, 'no_create_edit': True}"/>
              <field name="return_dttm"/>
              <field name="valid_until_date" invisible="1"/>
              <field name="medic_control_ret_dttm"/>
              <field name="odometer_ret"/>
            </group>
          </group>
          <group>
            <field name="notes"/>
            <field name="issue_date"/>
            <field name="mileage"/>
            <field name="strict_doc_id" readonly="1" invisible="1"/>
            <field name="reverse_trip_ids" nolabel="1" readonly="1">
                <list create="0" delete="0" edit="0">
                    <field name="name"/>
                    <field name="start_datetime" string="Start"/>
                    <field name="stop_datetime" string="End"/>
                    <field name="vehicle_id" string="Truck"/>
                    <field name="trailer_id" string="Trailer" optional="show"/>
                    <field name="driver_id" string="Driver"/>
                    <field name="trip_route" string="Route" optional="show"/>
                    <field name="state" string="Status"/>
                </list>
            </field>
            <field name="truck_docs_ids" widget="many2many_tags" options="{'color_field':'color'}" invisible="not truck_docs_ids"/>
            <field name="trailer_docs_ids" widget="many2many_tags" options="{'color_field':'color'}" invisible="not trailer_docs_ids"/>
            <field name="driver_docs_ids" widget="many2many_tags" options="{'color_field':'color'}" invisible="not driver_docs_ids"/>
            <field name="driver2_docs_ids" widget="many2many_tags" options="{'color_field':'color'}" invisible="not driver2_docs_ids"/>
          </group>
        </sheet>
        <chatter open_attachments="True" reload_on_attachment="True"/>

      </form>]]></field>
    </record>
    <record id="ufs_ufs_waybill_tree" model="ir.ui.view">
        <field name="name">ufs.waybill.tree</field>
        <field name="model">ufs.waybill</field>
        <field name="type">list</field>
        <field name="priority">16</field>
        <field name="arch"><![CDATA[<list string="Waybills">
        <field name="name"/>
        <field name="truck_id" optional="show"/>
        <field name="trailer_id"/>
        <!--        <field name="ufs_trailer_id" optional="show"/>-->
        <field name="driver_id" optional="show"/>
        <field name="driver2_id" optional="show"/>
        <field name="issue_date" optional="show"/>
        <field name="departure_dttm" optional="show"/>
        <field name="medic_control_dep_dttm" optional="show"/>
        <field name="odometer_dep" optional="show"/>
        <field name="odometer_ret" optional="show"/>
        <field name="mileage" optional="show"/>
        <field name="medic_control_ret_dttm" optional="show"/>
        <field name="return_dttm" optional="show"/>
        <field name="state" optional="show"/>
      </list>]]></field>
    </record>
</data>
</odoo>
